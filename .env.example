# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Set these in the Leapcell dashboard → Service → Environment
# DO NOT commit .env to git — use this file as reference only
# ============================================================

# Django
SECRET_KEY=your-secret-key-min-50-chars-random-string-here
DEBUG=False
# Comma-separated list of allowed hosts (your Leapcell domain)
ALLOWED_HOSTS=your-app.leapcell.dev

# PostgreSQL — set this to your connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# Leave unset to fall back to SQLite (development only)
DATABASE_URL=postgres://user:password@localhost:5432/docmonk

# Storage: set to "r2" in production to use Cloudflare R2
STORAGE_BACKEND=r2

# Cloudflare R2
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# AI Provider Pool — Groq (keys 1 & 2) + Cerebras (keys 1 & 2)
# At least one key must be set; unused slots are simply skipped.
GROQ_API_KEY_1=your_groq_api_key_1
GROQ_API_KEY_2=your_groq_api_key_2
CEREBRAS_KEY_1=your_cerebras_key_1
CEREBRAS_KEY_2=your_cerebras_key_2
GROQ_MODEL=llama-3.3-70b-versatile

# CORS — comma-separated list of allowed frontend origins (include https://)
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://staging.example.com
# Set CORS_ALLOW_ALL_ORIGINS=true only for fully public APIs (no credentials)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CORS_ALLOW_ALL_ORIGINS=false
