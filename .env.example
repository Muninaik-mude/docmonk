# ============================================================
# PRODUCTION ENVIRONMENT VARIABLES
# Set these in the Leapcell dashboard → Service → Environment
# DO NOT commit .env to git — use this file as reference only
# ============================================================

# Django
SECRET_KEY=your-secret-key-min-50-chars-random-string-here
DEBUG=False
# Comma-separated list of allowed hosts (your Leapcell domain)
ALLOWED_HOSTS=your-app.leapcell.dev

# Storage: set to "r2" in production to use Cloudflare R2
STORAGE_BACKEND=r2

# Cloudflare R2
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Groq AI
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
